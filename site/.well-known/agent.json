{
  "schema_version": "1.0",
  "name": "agent-middleware-api",
  "description": "This marketing host points machines to the Agent Middleware API governed MCP gateway for scoped authority, at-most-one gateway dispatch and debit per accepted key for configured upstream MCP tools, and signed receipts.",
  "primary_audience": "autonomous_agents",
  "buyer_audience": [
    "platform_engineering",
    "ai_infrastructure",
    "security_teams_operating_internal_mcp_tools"
  ],
  "product_wedge": "governed_mcp_trust_plane",
  "thesis": "Before an autonomous agent acts, it needs bounded authority and portable proof.",
  "product_loop": [
    "discover",
    "authenticate",
    "authorize",
    "invoke",
    "meter",
    "receipt",
    "audit",
    "govern"
  ],
  "canonical_api": "https://api.thisisatest.tech",
  "human_site": "https://www.thisisatest.tech/",
  "github": "https://github.com/PetrefiedThunder/agent-middleware-api",
  "github_access": "public",
  "discovery": {
    "agent_manifest": "https://api.thisisatest.tech/.well-known/agent.json",
    "llm_txt": "https://api.thisisatest.tech/llm.txt",
    "llms_txt": "https://api.thisisatest.tech/llms.txt",
    "mcp_tools": "https://api.thisisatest.tech/mcp/tools.json",
    "openapi": "https://api.thisisatest.tech/openapi.json",
    "capability_index": "https://api.thisisatest.tech/v1/discover",
    "dependency_truth": "https://api.thisisatest.tech/health/dependencies"
  },
  "bootstrap_sequence": [
    "https://api.thisisatest.tech/.well-known/agent.json",
    "https://api.thisisatest.tech/llms.txt",
    "https://api.thisisatest.tech/mcp/tools.json",
    "https://api.thisisatest.tech/openapi.json"
  ],
  "simulation_and_dependency_truth": "https://api.thisisatest.tech/health/dependencies",
  "try_it": {
    "mode": "local_self_hosted",
    "repository": "https://github.com/PetrefiedThunder/agent-middleware-api",
    "repository_access": "public",
    "command": "make prove-trust-plane",
    "live_access": "operator_issued",
    "requires_live_credentials": false,
    "proves": [
      "scoped_permit",
      "metered_mcp_invoke",
      "signed_receipt",
      "replay_without_second_charge",
      "out_of_scope_denial",
      "offline_receipt_verification"
