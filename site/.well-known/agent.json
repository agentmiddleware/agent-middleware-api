    "note": "Runs the real FastAPI trust path against a throwaway local SQLite database. This is a reproducible proof, not a production or settlement claim. The source repository is public; clone it and run the proof locally before treating it as production evidence."
  },
  "authentication": {
    "type": "api_key",
    "header": "X-API-Key",
    "note": "No public self-serve key mint on this marketing host. Operator-issued keys required."
  },
  "note": "This file is a pointer only. Do not treat this marketing origin as the API base URL."
}
