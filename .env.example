# Agent-Native Middleware API — Environment Configuration
# Copy this to .env and fill in your values

# --- Application ---
APP_NAME="Agent-Native Middleware API"
APP_VERSION="1.2.0"
# local | development | test | production (production-like engages trust guardrails)
ENVIRONMENT=local
DEBUG=false

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Public URL (agent manifests, /llm.txt Base URL, OpenAPI servers) ---
# Production Railway API host example:
# PUBLIC_URL=https://api-service-production-433c.up.railway.app
PUBLIC_URL=

# --- CORS ---
# Comma-separated origins (e.g., https://app.example.com,https://dashboard.example.com)
# Use * for development only
CORS_ORIGINS=*

# --- Durable Runtime State ---
# Options: postgres, redis, sqlite, memory, auto (default: auto)
# Silent memory fallback is refused when ENVIRONMENT is production-like.
#
# Defaults below are the local SQLite path from the README, so that copying this
# file and filling in the signing seed yields a server that actually boots. Run
# `mkdir -p data` first. Production-like deployments use the postgres block.
STATE_BACKEND=sqlite
STATE_NAMESPACE=agent_middleware
DATABASE_URL=sqlite+aiosqlite:///./data/local_api.db
SQLITE_URL=./data/local_state.db

# Production-like: swap the three values above for postgres. Either URL form
# works; the app normalizes for SQLAlchemy (+asyncpg) and raw asyncpg.
# STATE_BACKEND=postgres
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
# Docker/Railway: set true so the entrypoint runs `alembic upgrade head` before
# uvicorn. Required for production schema (create_all is disabled in
# production-like environments). Fails closed if true but DATABASE_URL is empty.
# RUN_MIGRATIONS_ON_START=true
REDIS_URL=

# --- Authentication ---
# Comma-separated API keys.
# Open/development mode (unauthenticated calls accepted) requires BOTH an empty
# value here AND DEBUG=true — see app/core/auth.py. With the DEBUG=false shipped
# above, leaving this empty makes every authenticated request fail closed with
# 403 invalid_api_key, which is the safe default but is NOT open mode.
# Production: set real secrets via the host secrets manager / Railway variables.
# Never commit real keys. Never use the placeholder value "change-me".
VALID_API_KEYS=

# --- Trust plane (REQUIRED — the app does not start without a signing seed) ---
# Full Railway SOP: docs/deploy-railway.md
#
# TRUST_MODE_ENABLED defaults to true, and trust mode refuses to start without
# signing material, so TRUST_SIGNING_PRIVATE_KEY_B64 is required in EVERY
# environment including local. Leaving it empty fails startup with
# `SigningKeyError: trust_signing_private_key_required`.
#
# Generate a seed once per database, then reuse it on every restart:
#   python3 -c 'import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
#
# Value is strict base64 of exactly 32 raw bytes. Never commit a real seed, and
# never reuse a local seed in a shared environment. Changing key material under
# an existing TRUST_SIGNING_KEY_ID is rejected to preserve historical
# verification, so pick a new key ID when you rotate.
TRUST_SIGNING_PRIVATE_KEY_B64=
TRUST_SIGNING_KEY_ID=local-dev-ed25519

# Production-like must keep these three at exactly the values shown.
TRUST_MODE_ENABLED=true
ALLOW_LEGACY_UNPERMITTED_MCP=false
ENABLE_PROOF_SURFACES=false

# --- Dogfood tool (opt-in; default off) ---
# When true, registers executable partner.notes.write so /mcp/tools.json is
# non-empty for live permit→invoke→receipt dogfood. Safe side effect: appends
# to data/dogfood_partner_notes.jsonl (ephemeral on Railway). Does NOT enable
# Phase9 / AWI / marketplace stubs (those stay behind ENABLE_PROOF_SURFACES).
# ENABLE_DOGFOOD_TOOL=false

# --- Standard MCP endpoint (POST /mcp; default off) ---
# Spec-compliant stateless Streamable HTTP surface for standard MCP clients.
# tools/call mints a bounded single-tool permit from the caller's wallet
# before entering the governed invoke path. Enable deliberately; the MCP
# registry publish gate preflights this endpoint.
ENABLE_STANDARD_MCP_ENDPOINT=false
STANDARD_MCP_PERMIT_TTL_SECONDS=120

# --- Design-partner upstream MCP tool (single server/tool; default off) ---
# Production requires a public HTTPS Streamable HTTP endpoint. Plain HTTP is
# accepted only for an explicit loopback URL in local/test environments. Keep
# the bearer token in Railway/host secret storage; never commit it here.
MCP_UPSTREAM_ENABLED=false
MCP_UPSTREAM_URL=
MCP_UPSTREAM_TOOL_NAME=
MCP_UPSTREAM_PUBLIC_TOOL_ID=
MCP_UPSTREAM_BEARER_TOKEN=
MCP_UPSTREAM_CREDITS_PER_CALL=0
MCP_UPSTREAM_CONNECT_TIMEOUT_SECONDS=5
MCP_UPSTREAM_CALL_TIMEOUT_SECONDS=30
MCP_UPSTREAM_MAX_RESPONSE_BYTES=1048576

# --- IoT Protocol Bridge ---
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_DEFAULT_QOS=1
MQTT_ENFORCE_TOPIC_ACL=true

# --- Telemetry / Autonomous PM ---
TELEMETRY_RETENTION_HOURS=168
AUTO_PR_ENABLED=false
GIT_REMOTE_URL=
GIT_BRANCH_PREFIX=auto-pm/

# --- Media Engine ---
MAX_UPLOAD_SIZE_MB=500
SUPPORTED_VIDEO_FORMATS=mp4,mov,webm,mkv
CAPTION_LANGUAGE=en

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=120

# --- Billing / AgentMoney ---
# 1000 credits = $1.00 USD (1 credit = $0.001)
EXCHANGE_RATE=1000.0

# --- Stripe Payment Processing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- KYC Verification ---
# Require KYC verification before allowing fiat top-ups
KYC_REQUIRED_FOR_TOPUP=false

# --- Notification Service (Resend for Email) ---
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@b2a.dev

# --- Notification Service (Slack) ---
SLACK_WEBHOOK_URL=

# --- Sentinel Human Approval (pauseapi.app) ---
# Backs permits created with requires_human_approval=true: governed invokes
# under such a permit block on a human decision before any credits move.
# Real mode (SIMULATION_MODE_HUMAN_APPROVAL=false) requires both values;
# missing config fails closed (permit creation and invokes are denied).
SENTINEL_API_URL=
SENTINEL_API_KEY=
# Local approval expiry, also forwarded as Sentinel timeout_seconds (1..86400).
# Sentinel never expires approvals server-side; the middleware enforces this.
SENTINEL_APPROVAL_TIMEOUT_SECONDS=300
# >0: long-poll Sentinel this many seconds on first invoke for an instant
# decision before returning human_approval_pending (max 300).
SENTINEL_WAIT_SECONDS=0
# Comma-separated approvers (email, mailto:, or sms:+E164). Empty defers to
# the Sentinel tenant's default approvers.
SENTINEL_APPROVERS=
# Risk level attached to approval requests: low|medium|high|critical
SENTINEL_RISK_LEVEL=high

# --- Velocity Monitoring ---
# Freeze wallet after this many alert-threshold breaches in 1 hour
VELOCITY_FREEZE_THRESHOLD=3
# Send alert after this many standard deviations above average spend
VELOCITY_ALERT_THRESHOLD=2
# Hourly spend limit in credits (triggers alert/freeze)
VELOCITY_HOURLY_LIMIT=1000.0
# Daily spend limit in credits (triggers alert/freeze)
VELOCITY_DAILY_LIMIT=10000.0

# --- Simulation Mode (per-service) ---
# Default: true for every service. Flip to false only after an explicit product
# decision unfreezes the surface and the matching real adapter lands. See
# docs/PROOF_SURFACES.md.
# Flipping a flag early raises NotImplementedError at the guard site —
# intentional: prevents silent stubs-in-prod.
SIMULATION_MODE_ORACLE=true
SIMULATION_MODE_RED_TEAM=true
SIMULATION_MODE_RTAAS=true
SIMULATION_MODE_MEDIA_ENGINE=true
SIMULATION_MODE_IOT_BRIDGE=true
SIMULATION_MODE_TELEMETRY_PM=true
SIMULATION_MODE_AGENT_COMMS=true
SIMULATION_MODE_CONTENT_FACTORY=true
# Human-approval gate: simulated approvals auto-approve (marked simulated) in
# local/dev ONLY — production-like environments fail closed instead of
# honoring a simulated approval. Flip to false + set SENTINEL_* for real mode.
SIMULATION_MODE_HUMAN_APPROVAL=true
